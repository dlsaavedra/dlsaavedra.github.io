?quantile()
n = 100
mu = 10
sigma = 1
m = 100
est1 = numeric(m)
est2 = numeric(m)
est3 = numeric(m)
est4 = numeric(m)
for (j in 1:m){
x = rnorm(n, mean = mu, sd = sigma)
est1[j] = (max(x) - min(x))/2
est2[j] = (quantile(x, probs = .25) + quantile(x, probs = .75))/2
est3[j] = quantile(x, probs = 0.5)
est4[j] = mean(x)
}
